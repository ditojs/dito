{
  "name": "@ditojs/server",
  "version": "7.0.0-next.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./internal": "./src/internal.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@ditojs/utils": "workspace:^"
  },
  "peerDependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/node": "^26.6.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "import": "./dist/internal.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditojs/dito.git",
    "directory": "packages/server"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    }
  }
}
