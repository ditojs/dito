{
  "name": "@ditojs/auth",
  "version": "7.0.0-next.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@ditojs/utils": "workspace:^",
    "@simplewebauthn/server": "^14.0.3",
    "aaguids": "^0.0.71",
    "bcryptjs": "^3.0.3",
    "otpauth": "^9.5.2"
  },
  "devDependencies": {
    "@ditojs/mikro": "workspace:^",
    "@ditojs/server": "workspace:^",
    "@mikro-orm/core": "^7.2.8",
    "@types/node": "^26.6.4",
    "hono": "^4.13.14",
    "kysely": "0.29.8",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@ditojs/mikro": "workspace:^",
    "@ditojs/server": "workspace:^",
    "@mikro-orm/core": "^7.2.5",
    "hono": "^4.13.14",
    "kysely": "^0.29.6",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test/"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "import": "./dist/internal.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditojs/dito.git",
    "directory": "packages/auth"
  }
}
