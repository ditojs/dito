{
  "name": "@ditojs/ui",
  "version": "6.8.0",
  "type": "module",
  "description": "Dito.js UI is a simple UI library, built with Vue.js for use in Dito.js Admin and elsewhere",
  "repository": "https://github.com/ditojs/dito/tree/main/packages/ui",
  "author": "Jürg Lehni <juerg@scratchdisk.com> (http://scratchdisk.com)",
  "license": "MIT",
  "main": "./dist/dito-ui.es.js",
  "exports": {
    ".": {
      "import": "./dist/dito-ui.es.js"
    },
    "./style.css": "./dist/dito-ui.css",
    "./src": "./src/index.js",
    "./imports.scss": "./src/styles/_imports.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "dist/",
    "!src/**/*.test.js",
    "!src/**/__snapshots__/",
    "!src/test/",
    "!src/**/node_modules/"
  ],
  "scripts": {
    "build:icons": "inline-assets src/icons/*.svg --template src/icons/template.js > src/styles/mixins/_icons.scss",
    "build:vite": "vite build",
    "build": "pnpm run build:icons && pnpm run build:vite",
    "watch": "pnpm run build:vite --mode 'development' --watch",
    "prepare": "pnpm run build"
  },
  "engines": {
    "node": ">= 24.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie > 0",
    "not ie_mob > 0"
  ],
  "dependencies": {
    "@ditojs/utils": "workspace:^"
  },
  "peerDependencies": {
    "reka-ui": "^2.11.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@ditojs/build": "workspace:^",
    "reka-ui": "^2.11.0",
    "vite": "^8.3.7",
    "vue": "^3.5.45"
  }
}
