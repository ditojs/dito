{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  // `@ditojs/storage` resolves to its sources, which need their declarations.
  "include": ["src", "../storage/src/*.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
