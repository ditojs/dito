{
  "name": "@ditojs/storage",
  "version": "7.0.0-next.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@ditojs/utils": "workspace:^",
    "@types/busboy": "^1.5.5",
    "@types/picomatch": "^4.0.3",
    "busboy": "^1.6.0",
    "file-type": "^22.1.1",
    "leather": "^3.0.3",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@aws-lite/client": "^0.24.1",
    "@aws-lite/s3": "^0.2.7",
    "@ditojs/mikro": "workspace:^",
    "@ditojs/server": "workspace:^",
    "@hono/node-server": "^2.1.5",
    "@mikro-orm/core": "^7.2.8",
    "@types/node": "^26.6.4",
    "hono": "^4.13.14",
    "kysely": "0.29.8"
  },
  "peerDependencies": {
    "@aws-lite/client": "^0.24.0",
    "@aws-lite/s3": "^0.2.7",
    "@ditojs/mikro": "workspace:^",
    "@ditojs/server": "workspace:^",
    "@hono/node-server": "^2.1.5",
    "@mikro-orm/core": "^7.2.5",
    "hono": "^4.13.14",
    "kysely": "^0.29.6"
  },
  "peerDependenciesMeta": {
    "@aws-lite/client": {
      "optional": true
    },
    "@aws-lite/s3": {
      "optional": true
    },
    "@hono/node-server": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test/"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditojs/dito.git",
    "directory": "packages/storage"
  }
}
