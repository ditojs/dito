{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "**/*.ts",
    "../packages/storage/src/leather.d.ts",
    "../packages/storage/src/aws-lite-s3.d.ts"
  ],
  "exclude": [
    "e2e/**",
    "utils/admin-app/**"
  ]
}
